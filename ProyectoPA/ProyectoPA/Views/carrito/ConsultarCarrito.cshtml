@using System.Linq
@using System.Globalization
@model List<ProyectoPA.Models.CarritoModel>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Carrito de Compras";

    var primerDiseno = Model != null ? Model.FirstOrDefault() : null;
}

<div class="container-fluid bg-light page-header py-5 mb-5">
    <div class="container text-center py-4">
        <h1 class="display-5 animated slideInLeft">
            <i class="bi bi-cart3 text-primary me-2"></i>Carrito de Compras
        </h1>
    </div>
</div>

<div class="container py-5">
    @using (Html.BeginForm())
    {
        if (ViewBag.Message != null && !string.IsNullOrWhiteSpace(ViewBag.Message.ToString()))
        {
            <div class="alert alert-warning alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle me-2"></i>
                @ViewBag.Message
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
            </div>
        }

        if (Model != null && Model.Any())
        {
            <div class="row g-3">
                @foreach (var item in Model)
                {
                    <div class="col-12">
                        <div class="card border-0 shadow-sm">
                            <div class="card-body p-3">
                                <div class="row g-3 align-items-center">

                                    @* Imagen del diseño *@
                                    <div class="col-4 col-md-2 text-center">
                                        <img src="@Url.Content(item.Imagen ?? string.Empty)"
                                             class="img-fluid rounded border"
                                             alt="Dise&ntilde;o personalizado" />
                                    </div>

                                    @* Detalle del diseño *@
                                    <div class="col-8 col-md-10">

                                        @* Encabezado de la tarjeta *@
                                        <div class="d-flex justify-content-between align-items-center border-bottom pb-2 mb-2">
                                            <h3 class="h5 mb-0">
                                                <i class="bi bi-palette text-primary me-2"></i>Dise&ntilde;o personalizado
                                            </h3>
                                            <a href="@Url.Action("EliminarDiseno", "Carrito", new { id = item.IdDiseno })"
                                               class="btn btn-outline-danger btn-sm">
                                                <i class="bi bi-trash me-1"></i>
                                                Eliminar
                                            </a>
                                        </div>

                                        @* Especificaciones en una sola línea *@
                                        <div class="row g-2 align-items-center">
                                            <div class="col-6 col-md-2">
                                                <span class="d-block text-muted small text-uppercase">Material</span>
                                                <span class="fw-semibold"><i class="bi bi-layers me-1"></i>@item.Material</span>
                                            </div>
                                            <div class="col-6 col-md-2">
                                                <span class="d-block text-muted small text-uppercase">Tama&ntilde;o</span>
                                                <span class="fw-semibold"><i class="bi bi-aspect-ratio me-1"></i>@item.Tamano</span>
                                            </div>
                                            <div class="col-12 col-md-4">
                                                <span class="d-block text-muted small text-uppercase">Texto Personalizado</span>
                                                <span class="fw-semibold"><i class="bi bi-fonts me-1"></i>@item.Texto</span>
                                            </div>
                                            <div class="col-6 col-md-2 text-md-end">
                                                <span class="d-block text-muted small text-uppercase">Precio Material</span>
                                                <span class="fw-semibold">&#8353;@item.PrecioMaterial.ToString("N2", CultureInfo.InvariantCulture)</span>
                                            </div>
                                            <div class="col-6 col-md-2 text-md-end">
                                                <span class="d-block text-muted small text-uppercase">Precio Tama&ntilde;o</span>
                                                <span class="fw-semibold">&#8353;@item.PrecioTamano.ToString("N2", CultureInfo.InvariantCulture)</span>
                                            </div>
                                        </div>

                                        @* Desglose tipo factura *@
                                        <div class="row g-2 align-items-center bg-light rounded border mt-3 mx-0 py-2">
                                            <div class="col-6 col-md-3 text-md-end ms-md-auto">
                                                <span class="text-muted small text-uppercase me-1">Subtotal</span>
                                                <span class="fw-semibold">&#8353;@item.Subtotal.ToString("N2", CultureInfo.InvariantCulture)</span>
                                            </div>
                                            <div class="col-6 col-md-3 text-md-end">
                                                <span class="text-muted small text-uppercase me-1">IVA</span>
                                                <span class="fw-semibold">&#8353;@item.IVA.ToString("N2", CultureInfo.InvariantCulture)</span>
                                            </div>
                                            <div class="col-12 col-md-4 text-end border-md-start">
                                                <span class="text-muted text-uppercase small me-2">Total</span>
                                                <span class="h4 text-primary fw-bold mb-0">&#8353;@item.Total.ToString("N2", CultureInfo.InvariantCulture)</span>
                                            </div>
                                        </div>

                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>

            @* Resumen general *@
            <div class="card border-0 shadow-sm mt-4">
                <div class="card-body p-3">
                    <div class="d-flex align-items-center border-bottom pb-2 mb-3">
                        <i class="bi bi-receipt text-primary fs-3 me-2"></i>
                        <h2 class="h4 mb-0">Resumen de Compra</h2>
                    </div>

                    <div class="row justify-content-end">
                        <div class="col-md-6 col-lg-4">
                            <div class="d-flex justify-content-between border-bottom py-2">
                                <span>Subtotal General</span>
                                <span id="subtotalGeneral" class="fw-semibold">&#8353;@Model.Sum(x => x.Subtotal).ToString("N2", CultureInfo.InvariantCulture)</span>
                            </div>
                            <div class="d-flex justify-content-between border-bottom py-2">
                                <span>IVA General</span>
                                <span id="ivaGeneral" class="fw-semibold">&#8353;@Model.Sum(x => x.IVA).ToString("N2", CultureInfo.InvariantCulture)</span>
                            </div>
                            <div class="d-flex justify-content-between align-items-center py-3">
                                <span class="h5 mb-0">Total General</span>
                                <span id="totalGeneral" class="h4 text-primary fw-bold mb-0">&#8353;@Model.Sum(x => x.Total).ToString("N2", CultureInfo.InvariantCulture)</span>
                            </div>
                            @if (primerDiseno != null)
                            {
                                <a id="btnFinalizarPedido"
                                   href="@Url.Action("ConsultarFactura",
                                                     "Factura",
                                                     new { idDiseno = primerDiseno.IdDiseno })"
                                   class="btn btn-primary w-100">
                                    <i class="bi bi-check2-circle me-2"></i>
                                    Facturar Pedido
                                </a>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="card border-0 shadow-sm">
                <div class="card-body text-center py-5">
                    <i class="bi bi-cart-x text-primary display-4"></i>
                    <p class="lead mt-3 mb-0">No existen dise&ntilde;os en el carrito.</p>
                </div>
            </div>
        }
    }
</div>
