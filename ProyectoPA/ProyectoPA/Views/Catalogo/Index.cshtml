@model List<ProyectoPA.EF.FIDE_PLACA_TB>
@{
    ViewBag.Title = "Catálogo";

    var materiales = Model.Select(x => x.MATERIAL)
                          .Where(m => !string.IsNullOrWhiteSpace(m))
                          .Distinct()
                          .ToList();
}

<div class="container-fluid py-5 bg-light">
    <div class="container">
        <div class="text-center wow fadeIn" data-wow-delay="0.1s">
            <h1 class="font-dancing-script text-primary">Catálogo</h1>
            <h1 class="mb-5">Nuestras placas</h1>
        </div>

        @if (ViewBag.Message != null)
        {
            <div class="alert alert-danger text-center">@ViewBag.Message</div>
        }

        <div class="input-group input-group-lg mb-4">
            <span class="input-group-text bg-white border-end-0">
                <i class="bi bi-search"></i>
            </span>
            <input type="text" id="cdpBuscarPlaca" class="form-control border-start-0"
                   placeholder="Buscar placas premium...">
        </div>

        <div class="d-flex flex-wrap gap-2 mb-4" id="cdpFiltros">
            <button type="button" class="btn btn-sm btn-outline-dark text-uppercase cdp-filtro active" data-filtro="todos">
                <i class="bi bi-sliders me-1"></i> Todas las colecciones
            </button>

            @foreach (var material in materiales)
            {
                <button type="button" class="btn btn-sm btn-outline-dark text-uppercase cdp-filtro" data-filtro="@material">
                    @(char.ToUpper(material[0]) + material.Substring(1))
                </button>
            }
        </div>

        <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-4 g-4" id="cdpGridProductos">

            @foreach (var placa in Model)
            {
                var precio = "₡" + placa.PRECIO.ToString("N0");

                <div class="col cdp-producto"
                     data-material="@placa.MATERIAL"
                     data-nombre="@placa.NOMBRE"
                     data-precio="@precio"
                     data-imagen="@placa.IMAGEN_NOMBRE"
                     data-descripcion="@placa.DESCRIPCION">

                    <div class="bg-white h-100 d-flex flex-column" style="border: 1px solid #D4AF37;">
                        <img src="@placa.IMAGEN_NOMBRE" class="img-fluid w-100" alt="@placa.NOMBRE" style="height: 220px; object-fit: cover;">
                        <div class="p-3 d-flex flex-column flex-grow-1">
                            <h5 class="mb-3">@placa.NOMBRE</h5>
                            <div class="d-flex justify-content-between align-items-center mt-auto">
                                <span class="text-primary font-work-sans fs-5">@precio</span>
                                <div class="d-flex gap-2">
                                    <button type="button" class="btn btn-sm-square btn-outline-dark"
                                            title="Ver detalle"
                                            data-bs-toggle="modal"
                                            data-bs-target="#cdpModalDetalle">
                                        <i class="bi bi-eye"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }

        </div>

        <p id="cdpSinResultados" class="text-center text-secondary mt-5 @(Model.Any() ? "d-none" : "")">
            No encontramos placas que coincidan con tu búsqueda.
        </p>
    </div>
</div>

<!-- Modal Detalle -->
<div class="modal fade" id="cdpModalDetalle" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content rounded-0" style="border: 1px solid #D4AF37;">
            <div class="modal-header border-0">
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <div class="row g-4 align-items-center">
                    <div class="col-md-6">
                        <img id="cdpModalImagen" src="" alt="" class="img-fluid w-100">
                    </div>
                    <div class="col-md-6">
                        <h3 id="cdpModalNombre" class="mb-3"></h3>
                        <h4 id="cdpModalPrecio" class="text-primary font-work-sans mb-3"></h4>
                        <p id="cdpModalDescripcion" class="text-secondary"></p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script src="~/assets/js/catalogo.js"></script>
}
