
@model List<ProyectoPA.Models.UsuarioModel>

@{
    ViewBag.Title = "Administración de Usuarios";
}

<div class="container mt-5 mb-5">

    <h2 class="mb-4">Administración de Usuarios</h2>

    <p class="text-muted">
        Desde esta sección puede consultar, editar,
        administrar roles y desactivar usuarios registrados.
    </p>

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success">
            @TempData["Mensaje"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-body">

            <h5 class="card-title mb-3">
                Usuarios registrados
            </h5>

            <div class="table-responsive">

                <table class="table table-bordered table-striped">

                    <thead class="table-dark">
                        <tr>
                            <th>ID</th>
                            <th>Cédula</th>
                            <th>Nombre completo</th>
                            <th>Correo electrónico</th>
                            <th>Estado</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (Model != null && Model.Count > 0)
                        {
                            foreach (var usuario in Model)
                            {
                                <tr>
                                    <td>@usuario.ID_USUARIO</td>

                                    <td>@usuario.CEDULA</td>

                                    <td>
                                        @usuario.NOMBRE
                                        @usuario.PRIMER_APELLIDO
                                        @usuario.SEGUNDO_APELLIDO
                                    </td>

                                    <td>@usuario.CORREO</td>

                                    <td>
                                        @if (usuario.ID_ESTADO == 1)
                                        {
                                            <span class="badge bg-success">
                                                Activo
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                Inactivo
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        <div class="d-flex gap-2 flex-wrap">

                                            <a href="@Url.Action(
                                                "EditarUsuario",
                                                "Usuario",
                                                new { id = usuario.ID_USUARIO })"
                                               class="btn btn-warning btn-sm">
                                                Editar
                                            </a>

                                            <a href="@Url.Action(
                                                "AdministrarRoles",
                                                "Usuario",
                                                new { id = usuario.ID_USUARIO })"
                                               class="btn btn-primary btn-sm">
                                                Administrar roles
                                            </a>

                                            @if (usuario.ID_ESTADO == 1)
                                            {
                                                using (Html.BeginForm(
                                                    "DesactivarUsuario",
                                                    "Usuario",
                                                    FormMethod.Post))
                                                {
                                                    @Html.AntiForgeryToken()

                                                    <input type="hidden"
                                                           name="id"
                                                           value="@usuario.ID_USUARIO" />

                                                    <button type="submit"
                                                            class="btn btn-danger btn-sm"
                                                            onclick="return confirm('¿Está seguro de desactivar este usuario?');">
                                                        Desactivar
                                                    </button>
                                                }
                                            }

                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6"
                                    class="text-center text-muted">
                                    No hay usuarios registrados.
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        </div>
    </div>

</div>
