
@model List<ProyectoPA.Models.UsuarioModel>

@{
    ViewBag.Title = "Administración de Usuarios";
}

<style>
    .tabla-usuarios th,
    .tabla-usuarios td {
        vertical-align: middle;
    }

    .acciones-usuario {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
    }

        .acciones-usuario .btn-accion {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            height: 34px;
            padding: 0 12px;
            font-size: 13px;
            font-weight: 500;
            line-height: 1;
            border-radius: 5px;
            text-decoration: none;
            white-space: nowrap;
            box-sizing: border-box;
            transition: all 0.2s ease;
        }

        .acciones-usuario .btn-editar {
            background-color: #D4AF37;
            border: 1px solid #D4AF37;
            color: #212529;
        }

            .acciones-usuario .btn-editar:hover {
                background-color: #b8962e;
                border-color: #b8962e;
                color: #212529;
            }

        .acciones-usuario .btn-roles {
            background-color: #0d6efd;
            border: 1px solid #0d6efd;
            color: white;
        }

            .acciones-usuario .btn-roles:hover {
                background-color: #0b5ed7;
                color: white;
            }

        .acciones-usuario .btn-desactivar {
            background-color: #dc3545;
            border: 1px solid #dc3545;
            color: white;
            cursor: pointer;
        }

            .acciones-usuario .btn-desactivar:hover {
                background-color: #bb2d3b;
                color: white;
            }

        .acciones-usuario form {
            margin: 0;
            display: inline-flex;
            align-items: center;
        }

    /* Ventana de confirmación */
    .modal-desactivar .modal-content {
        border: none;
        border-radius: 12px;
        overflow: hidden;
    }

    .modal-desactivar .modal-header {
        background-color: #343a40;
        color: #D4AF37;
        border-bottom: 2px solid #D4AF37;
    }

    .modal-desactivar .icono-advertencia {
        font-size: 45px;
        color: #dc3545;
    }

    .modal-desactivar .btn-confirmar {
        background-color: #dc3545;
        color: white;
        border: none;
    }

        .modal-desactivar .btn-confirmar:hover {
            background-color: #bb2d3b;
            color: white;
        }
</style>

<div class="container mt-5 mb-5">

    <h2 class="mb-4">Administración de Usuarios</h2>

    <p class="text-muted">
        Desde esta sección puede consultar, editar,
        administrar roles y desactivar usuarios registrados.
    </p>

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success">
            @TempData["Mensaje"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-body">

            <h5 class="card-title mb-3">
                Usuarios registrados
            </h5>

            <div class="table-responsive">

                <table class="table table-bordered table-striped tabla-usuarios">

                    <thead class="table-dark">
                        <tr>
                            <th>ID</th>
                            <th>Cédula</th>
                            <th>Nombre completo</th>
                            <th>Correo electrónico</th>
                            <th>Estado</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (Model != null && Model.Count > 0)
                        {
                            foreach (var usuario in Model)
                            {
                                <tr>
                                    <td>@usuario.ID_USUARIO</td>

                                    <td>@usuario.CEDULA</td>

                                    <td>
                                        @usuario.NOMBRE
                                        @usuario.PRIMER_APELLIDO
                                        @usuario.SEGUNDO_APELLIDO
                                    </td>

                                    <td>@usuario.CORREO</td>

                                    <td>
                                        @if (usuario.ID_ESTADO == 1)
                                        {
                                            <span class="badge bg-success">
                                                Activo
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                Inactivo
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        <div class="acciones-usuario">

                                            <!-- EDITAR -->
                                            <a href="@Url.Action(
                                                "EditarUsuario",
                                                "Usuario",
                                                new { id = usuario.ID_USUARIO })"
                                               class="btn-accion btn-editar">
                                                <i class="fas fa-edit"></i>
                                                Editar
                                            </a>

                                            <!-- ADMINISTRAR ROLES -->
                                            <a href="@Url.Action(
                                                "AdministrarRoles",
                                                "Usuario",
                                                new { id = usuario.ID_USUARIO })"
                                               class="btn-accion btn-roles">
                                                <i class="fas fa-user-shield"></i>
                                                Administrar roles
                                            </a>

                                            <!-- DESACTIVAR -->
                                            @if (usuario.ID_ESTADO == 1)
                                            {
                                                <button type="button"
                                                        class="btn-accion btn-desactivar"
                                                        data-bs-toggle="modal"
                                                        data-bs-target="#modalDesactivar"
                                                        data-id="@usuario.ID_USUARIO"
                                                        data-nombre="@usuario.NOMBRE @usuario.PRIMER_APELLIDO">
                                                    <i class="fas fa-user-times"></i>
                                                    Desactivar
                                                </button>
                                            }

                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6"
                                    class="text-center text-muted">
                                    No hay usuarios registrados.
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        </div>
    </div>
</div>

<!-- MODAL DE CONFIRMACIÓN -->
<div class="modal fade modal-desactivar"
     id="modalDesactivar"
     tabindex="-1"
     aria-labelledby="tituloModalDesactivar"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title" id="tituloModalDesactivar">
                    Confirmar desactivación
                </h5>

                <button type="button"
                        class="btn-close btn-close-white"
                        data-bs-dismiss="modal"
                        aria-label="Cerrar">
                </button>
            </div>

            <div class="modal-body text-center p-4">

                <i class="fas fa-exclamation-triangle icono-advertencia mb-3"></i>

                <h5>¿Está seguro de desactivar este usuario?</h5>

                <p class="text-muted mt-3">
                    Está a punto de desactivar a:
                </p>

                <p class="fw-bold" id="nombreUsuarioDesactivar"></p>

                <p class="text-muted small">
                    El usuario pasará a estado inactivo.
                </p>

            </div>

            <div class="modal-footer justify-content-center">

                <button type="button"
                        class="btn btn-outline-secondary"
                        data-bs-dismiss="modal">
                    Cancelar
                </button>

                @using (Html.BeginForm(
                    "DesactivarUsuario",
                    "Usuario",
                    FormMethod.Post,
                    new { id = "formDesactivarUsuario" }))
                {
                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           name="id"
                           id="idUsuarioDesactivar" />

                    <button type="submit"
                            class="btn btn-confirmar">
                        <i class="fas fa-user-times me-1"></i>
                        Sí, desactivar
                    </button>
                }

            </div>

        </div>
    </div>
</div>

@section scripts {
    <script>
                document.addEventListener("DOMContentLoaded", function () {

                    var botones = document.querySelectorAll(
                        '[data-bs-target="#modalDesactivar"]'
                    );

                    botones.forEach(function (boton) {

                        boton.addEventListener("click", function () {

                            var idUsuario = boton.getAttribute("data-id");
                            var nombreUsuario = boton.getAttribute("data-nombre");

                            var campoId = document.getElementById(
                                "idUsuarioDesactivar"
                            );

                            var campoNombre = document.getElementById(
                                "nombreUsuarioDesactivar"
                            );

                            if (campoId !== null) {
                                campoId.setAttribute("value", idUsuario || "");
                            }

                            if (campoNombre !== null) {
                                campoNombre.textContent = nombreUsuario || "";
                            }

                        });

                    });

                });
    </script>
}


