
@model ProyectoPA.Models.UsuarioModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Editar Usuario";
}

<div class="container-fluid bg-light page-header py-5 mb-5">
    <div class="container text-center py-4">
        <h1 class="display-5 animated slideInLeft">
            <i class="bi bi-pencil-square text-primary me-2"></i>
            EDITAR USUARIO
        </h1>
    </div>
</div>

<div class="container py-5">

    <div class="row justify-content-center">
        <div class="col-12 col-lg-9">

            <div class="card border-0 shadow-sm">

                <div class="card-body p-4 p-md-5">

                    <div class="d-flex justify-content-between align-items-start border-bottom pb-3 mb-4">

                        <div>
                            <h2 class="h4 mb-1">
                                <i class="bi bi-person-gear text-primary me-2"></i>
                                Información del usuario
                            </h2>

                            <span class="text-muted small">
                                Modifique los datos del usuario seleccionado.
                            </span>
                        </div>

                        <i class="bi bi-person-circle text-primary fs-2"></i>

                    </div>

                    @using (Html.BeginForm("EditarUsuario", "Usuario", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()

                        @Html.HiddenFor(m => m.IdUsuario)

                        @Html.ValidationSummary(
                                 true,
                                 "",
                                 new { @class = "alert alert-danger" }
                             )

                        <div class="row g-3">

                            <div class="col-md-6">
                                <label class="form-label">
                                    <i class="bi bi-person-vcard text-primary me-2"></i>
                                    Cédula
                                </label>

                                @Html.TextBoxFor(
                                         m => m.Cedula,
                                         new { @class = "form-control" }
                                     )

                                @Html.ValidationMessageFor(
                                         m => m.Cedula,
                                         "",
                                         new { @class = "text-danger small" }
                                     )
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">
                                    <i class="bi bi-person text-primary me-2"></i>
                                    Nombre
                                </label>

                                @Html.TextBoxFor(
                                         m => m.Nombre,
                                         new { @class = "form-control" }
                                     )

                                @Html.ValidationMessageFor(
                                         m => m.Nombre,
                                         "",
                                         new { @class = "text-danger small" }
                                     )
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">
                                    Primer apellido
                                </label>

                                @Html.TextBoxFor(
                                         m => m.PrimerApellido,
                                         new { @class = "form-control" }
                                     )

                                @Html.ValidationMessageFor(
                                         m => m.PrimerApellido,
                                         "",
                                         new { @class = "text-danger small" }
                                     )
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">
                                    Segundo apellido
                                </label>

                                @Html.TextBoxFor(
                                         m => m.SegundoApellido,
                                         new { @class = "form-control" }
                                     )

                                @Html.ValidationMessageFor(
                                         m => m.SegundoApellido,
                                         "",
                                         new { @class = "text-danger small" }
                                     )
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">
                                    <i class="bi bi-envelope text-primary me-2"></i>
                                    Correo electrónico
                                </label>

                                @Html.TextBoxFor(
                                         m => m.Correo,
                                         new
                                         {
                                             @class = "form-control",
                                             type = "email"
                                         }
                                     )

                                @Html.ValidationMessageFor(
                                         m => m.Correo,
                                         "",
                                         new { @class = "text-danger small" }
                                     )
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">
                                    <i class="bi bi-image text-primary me-2"></i>
                                    URL de imagen de perfil
                                </label>

                                @Html.TextBoxFor(
                                         m => m.PerfilUrl,
                                         new { @class = "form-control" }
                                     )
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">
                                    <i class="bi bi-toggle-on text-primary me-2"></i>
                                    Estado
                                </label>

                                @Html.DropDownListFor(
                                         m => m.IdEstado,
                                         (SelectList)ViewBag.Estados,
                                         "Seleccione un estado",
                                         new { @class = "form-select" }
                                     )

                                @Html.ValidationMessageFor(
                                         m => m.IdEstado,
                                         "",
                                         new { @class = "text-danger small" }
                                     )
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">
                                    <i class="bi bi-geo-alt text-primary me-2"></i>
                                    Dirección
                                </label>


                                @Html.DropDownListFor(
                                    m => m.IdDireccion,
                                    ViewBag.Direcciones as SelectList,
                                    "Sin dirección",
                                    new { @class = "form-select" }
                                )


                                @Html.ValidationMessageFor(
                                              m => m.IdDireccion,
                                              "",
                                              new { @class = "text-danger small" }
                                          )
                            </div>

                        </div>

                        <hr class="my-4" />

                        <div class="d-flex flex-column flex-sm-row justify-content-between gap-2 mt-4">

                            <a href="@Url.Action("MostrarUsuarios", "Usuario")"
                               class="btn btn-outline-primary">
                                <i class="bi bi-arrow-left me-2"></i>
                                Volver a usuarios
                            </a>

                            <button type="submit"
                                    class="btn btn-primary">
                                <i class="bi bi-check-circle me-2"></i>
                                Guardar cambios
                            </button>

                        </div>
                    }

                </div>
            </div>

        </div>
    </div>
</div>
