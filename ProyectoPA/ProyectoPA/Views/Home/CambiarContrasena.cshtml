@model ProyectoPA.Models.UsuarioModel
@{
    ViewBag.Title = "Cambiar Contraseña";
}

<div class="container-fluid p-0 hero-header bg-light d-flex align-items-center justify-content-center" style="min-height: 100vh;">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-11 col-sm-9 col-md-6 col-lg-4">

                <div class="bg-white p-4 p-md-5 shadow-sm text-center" style="border: 1px solid #D4AF37;">

                    <h2 class="fw-bold mb-3" style="color: #1a1a1a; font-family: 'Playfair Display', serif;">
                        Cambiar Contraseña
                    </h2>

                    <p class="text-secondary mb-4">
                        Ingresa la nueva contraseña para su cuenta.
                    </p>

                    @using (Html.BeginForm("CambiarContrasena", "Home", FormMethod.Post, new { id = "cambiarContrasenaForm", @class = "text-start" }))
                    {
                        if (ViewBag.Message != null)
                        {
                            <div class="alert alert-danger text-center">@ViewBag.Message</div>
                        }

                        <div class="mb-4">
                            <label for="contrasena" class="form-label text-secondary">
                                Contraseña Nueva
                            </label>
                            <div class="campo-clave">
                                @Html.TextBoxFor(m => m.Contrasena, new { @class = "form-control", @placeholder = "••••••••", @minLength = "8", @type = "password" })

                                <button type="button" class="password-toggle-btn" id="toggle-password" aria-label="Show password">
                                    <i class="bi bi-eye"></i>
                                </button>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label for="confirmarContrasena" class="form-label text-secondary">
                                Confirmar Contraseña Nueva
                            </label>

                            <div class="campo-clave">
                                @Html.TextBoxFor(m => m.ConfirmarContrasena, new { @class = "form-control", @placeholder = "••••••••", @minLength = "8", @type = "password" })

                                <button type="button" class="password-toggle-btn" id="toggle-password" aria-label="Show password">
                                    <i class="bi bi-eye"></i>
                                </button>
                            </div>
                        </div>

                        <button type="submit"
                                class="btn btn-lg w-100 text-uppercase py-3 boton-ingresar">
                            Cambiar Contraseña
                        </button>

                    }

                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/assets/js/cambiarContrasena.js"></script>
    <script src="~/assets/js/auth.js"></script>
}