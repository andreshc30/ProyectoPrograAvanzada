@model ProyectoPA.Models.UsuarioModel
@{
    ViewBag.Title = "Inicio de sesión";
}


<div class="container-fluid p-0 hero-header bg-light d-flex align-items-center justify-content-center" style="min-height: 100vh;">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-11 col-sm-9 col-md-6 col-lg-4">
                <div class="bg-white p-4 p-md-5 shadow-sm text-center" style="border: 1px solid #D4AF37;">

                    <h1 class="font-dancing-script" style="color: #D4AF37; font-size: 2.4rem;">Bienvenido</h1>
                    <h2 class="fw-bold mb-4" style="color: #1a1a1a; font-family: 'Playfair Display', serif;">Inicio de sesión</h2>


                    @using (Html.BeginForm("Login", "Home", FormMethod.Post, new { id = "loginForm", @class = "text-start" }))
                    {
                        if (ViewBag.Message != null)
                        {
                            <div class="alert alert-danger text-center">@ViewBag.Message</div>
                        }

                        <div class="mb-3">
                            <label class="form-label text-secondary">Correo electrónico</label>
                            @Html.TextBoxFor(m => m.Correo, new { @class = "form-control", @placeholder = "correo@ejemplo.com" })
                        </div>

                        <div class="mb-4">
                            <label class="form-label text-secondary">Contraseña</label>
                            <div class="campo-clave">
                                @Html.TextBoxFor(m => m.Contrasena, new { @class = "form-control", @placeholder = "••••••••", @minLength = "8", @type = "password" })
                                <button type="button" class="password-toggle-btn" id="toggle-password" aria-label="Show password">
                                    <i class="bi bi-eye"></i>
                                </button>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-lg w-100 text-uppercase py-3 boton-ingresar">
                            Ingresar
                        </button>
                    }

                    <p class="mt-4 mb-2 text-secondary">
                        ¿No tienes cuenta?
                        <a href="@Url.Action("Registro", "Home")" style="color: #D4AF37; font-weight: 500;">Crear usuario</a>
                    </p>
                    <p class="mt-4 mb-2 text-secondary">
                        ¿Olvidaste tu contraseña?
                        <a href="@Url.Action("Recuperar", "Home")" style="color: #D4AF37; font-weight: 500;">Recuperar Contraseña</a>
                    </p>
                    <a href="@Url.Action("Index", "Home")" class="text-secondary small">
                        <i class="fa fa-arrow-left me-1"></i>Volver al inicio
                    </a>

                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/assets/js/login.js"></script>
    <script src="~/assets/js/auth.js"></script>
}