@{
    ViewBag.Title = "Inicio";
}

<!-- Hero Start -->
<div class="container-fluid p-0 hero-header bg-light d-flex align-items-center justify-content-center" style="min-height: 100vh;">
    <div class="container d-flex align-items-center justify-content-center p-0">
        <div class="row g-0 justify-content-center align-items-center">
            <div class="col-12 hero-header-text py-4">
                <div class="px-3 text-center">
                    <h1 class="font-dancing-script animated slideInDown" style="color: #D4AF37; font-size: 2.8rem;">Bienvenido a</h1>
                    <h1 class="display-1 fw-bold mb-4 animated slideInDown" style="font-size: 4.5rem; line-height: 1; color: #1a1a1a;">Casa La Placa</h1>
                    <p class="lead mb-4 animated slideInDown text-secondary" style="max-width: 800px; margin: 0 auto; font-size: 1.25rem;">
