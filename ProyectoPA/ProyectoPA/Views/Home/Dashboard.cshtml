@{
    ViewBag.Title = "Dashboard";
}

<!-- Hero Start -->
<div class="container-fluid py-5 bg-light">
    <div class="container text-center py-4">
        <h1 class="font-dancing-script animated slideInDown" style="color: #D4AF37; font-size: 2.4rem;">Fundición Jiménez · Desde 1990</h1>
        <h1 class="display-4 fw-bold mb-5 animated slideInDown" style="color: #1a1a1a;">Placas que conservan la memoria</h1>

        <div id="cdpCarruselPlacas" class="carousel slide mx-auto" data-bs-ride="carousel" style="max-width: 640px;">
            <div class="carousel-inner">

                <div class="carousel-item active">
                    <div class="bg-white p-5 shadow-sm" style="border: 1px solid #D4AF37;">
                        <span class="text-uppercase text-primary small" style="letter-spacing: 2px;">Reconocimiento</span>
                        <div class="my-3"><i class="bi bi-person-fill display-3 text-primary"></i></div>
                        <h3 class="mb-1">Ejemplo de Placa Conmemorativa</h3>
                        <p class="text-secondary mb-3">1950 - 2024</p>
                        <p class="font-playfair-display fst-italic mb-0">"Un espacio para honrar la memoria de quienes marcaron
                            nuestras vidas."</p>
                    </div>
                </div>

                <div class="carousel-item">
                    <div class="bg-white p-5 shadow-sm" style="border: 1px solid #D4AF37;">
                        <span class="text-uppercase text-primary small" style="letter-spacing: 2px;">Empresarial</span>
                        <div class="my-3"><i class="bi bi-award-fill display-3 text-primary"></i></div>
                        <h3 class="mb-1">Reconocimiento a Trayectoria</h3>
                        <p class="text-secondary mb-3">Entregado en el 2026</p>
                        <p class="font-playfair-display fst-italic mb-0">"Placas grabadas para logros, aniversarios y hitos
                            importantes."</p>
                    </div>
                </div>

                <div class="carousel-item">
                    <div class="bg-white p-5 shadow-sm" style="border: 1px solid #D4AF37;">
                        <span class="text-uppercase text-primary small" style="letter-spacing: 2px;">Mascotas</span>
                        <div class="my-3"><i class="bi bi-heart-fill display-3 text-primary"></i></div>
                        <h3 class="mb-1">Placa para Mascota</h3>
                        <p class="text-secondary mb-3">Siempre en casa</p>
                        <p class="font-playfair-display fst-italic mb-0">"Detalles personalizados para recordar a tu compañero
                            fiel."</p>
                    </div>
                </div>

            </div>

            <button class="carousel-control-prev" type="button" data-bs-target="#cdpCarruselPlacas" data-bs-slide="prev"
                    style="filter: invert(1); left: -60px;">
                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Anterior</span>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#cdpCarruselPlacas" data-bs-slide="next"
                    style="filter: invert(1); right: -60px;">
                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Siguiente</span>
            </button>

            <div class="carousel-indicators" style="bottom: -50px;">
                <button type="button" data-bs-target="#cdpCarruselPlacas" data-bs-slide-to="0" class="active bg-primary"
                        aria-current="true" aria-label="Placa 1"></button>
                <button type="button" data-bs-target="#cdpCarruselPlacas" data-bs-slide-to="1" class="bg-primary"
                        aria-label="Placa 2"></button>
                <button type="button" data-bs-target="#cdpCarruselPlacas" data-bs-slide-to="2" class="bg-primary"
                        aria-label="Placa 3"></button>
            </div>
        </div>
    </div>
</div>
<!-- Hero End -->

<!-- Servicios Start -->
<div class="container-fluid service py-5">
    <div class="container">
        <div class="text-center wow fadeIn" data-wow-delay="0.1s">
            <h1 class="font-dancing-script text-primary">Qué puedes hacer aquí</h1>
            <h1 class="mb-5">Tres formas de crear tu placa</h1>
        </div>
        <div class="row g-4 g-md-0 text-center">
            <div class="col-md-4">
                <div class="service-item h-100 p-4 border-end wow fadeIn" data-wow-delay="0.1s">
                    <i class="bi bi-brush display-4 text-primary d-block mb-3"></i>
                    <h3 class="mb-3">Arma tu placa</h3>
                    <p class="mb-0">Personaliza completamente tu placa conmemorativa o de reconocimiento. Elige material,
                        tamaño, forma, tipografía, íconos y mensaje, visualizando cada cambio en tiempo real.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="service-item h-100 p-4 border-end wow fadeIn" data-wow-delay="0.3s">
                    <i class="bi bi-award display-4 text-primary d-block mb-3"></i>
                    <h3 class="mb-3">Reconocimientos</h3>
                    <p class="mb-0">Crea placas destinadas a celebrar logros, méritos o agradecimientos. Selecciona modelos
                        predefinidos, personaliza mensajes y añade elementos decorativos.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="service-item h-100 p-4 wow fadeIn" data-wow-delay="0.5s">
                    <i class="bi bi-heart display-4 text-primary d-block mb-3"></i>
                    <h3 class="mb-3">Placas para mascotas</h3>
                    <p class="mb-0">Diseña placas identificativas o conmemorativas para tus animales. Elige forma, tamaño,
                        material y grabado, además de íconos relacionados con mascotas.</p>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Servicios End -->

<!-- Destacados Start -->
<div class="container-fluid py-5 bg-dark">
    <div class="container">
        <div class="text-center wow fadeIn" data-wow-delay="0.1s">
            <h1 class="font-dancing-script text-primary">Catálogo</h1>
            <h1 class="text-white mb-5">Productos destacados</h1>
        </div>

        <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-4 g-4 justify-content-center" id="cdpGridDestacados">
        </div>

        <p id="cdpDestacadosVacio" class="text-center text-white-50 mt-4 d-none">
            Todavía no hay placas destacadas para mostrar.
        </p>

        <div class="text-center mt-4">
            <a href="@Url.Action("Index", "Catalogo")" class="btn btn-lg text-uppercase px-4 py-3"
               style="border: 1px solid #D4AF37; color: #D4AF37; background: transparent;">Ver catálogo completo</a>
        </div>
    </div>
</div>
<!-- Destacados End -->

<!-- Historia Start -->
<div class="container-fluid py-5">
    <div class="container">
        <div class="row g-5 align-items-center">
            <div class="col-lg-4 text-center text-lg-start wow fadeIn" data-wow-delay="0.2s">
                <h1 class="font-dancing-script text-primary">Nuestra historia</h1>
                <h1 class="mb-2">La Casa de la Placa</h1>
                <p class="text-secondary mb-0">Concepción Arriba de Alajuelita, desde 1990</p>
            </div>
            <div class="col-lg-8 wow fadeIn" data-wow-delay="0.4s">
                <div class="bg-light p-4 p-md-5" style="border-left: 3px solid #D4AF37;">
                    <p class="mb-0">
                        "Fundición Jiménez" y "La Casa de la Placa" son empresas familiares fundadas
                        en los años 90 en Concepción Arriba de Alajuelita, por el señor Jorge Jiménez
                        Jiménez, como necesidad para sobrevivir y solventar la necesidad de placas
                        conmemorativas de la zona y reconocimientos empresariales y estudiantiles.
                        "La Casa de la Placa" fue creada como solución a la alta demanda de placas
                        conmemorativas en pandemia, ya que los dueños actuales se dieron cuenta de que
                        no daban abasto recibiendo solicitudes y produciendo. Separando las ventas de
                        la producción lograron establecer una línea de negocio continua y sin problemas
                        para recibir solicitudes.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Historia End -->

@section scripts {
    <script>
        // PENDIENTE (backend): estas rutas se usan para llamar a los endpoints que aún no existen en C#
        const BASE_URL = "@Url.Content("~/")";
        const ROOT_URL = "@Url.Content("~/")";
    </script>
    <script src="~/assets/js/inicio.js"></script>
}
