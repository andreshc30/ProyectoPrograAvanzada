@{
    ViewBag.Title = "Recuperar Contraseña";
}

<div class="container-fluid p-0 hero-header bg-light d-flex align-items-center justify-content-center" style="min-height: 100vh;">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-11 col-sm-9 col-md-6 col-lg-4">

                <div class="bg-white p-4 p-md-5 shadow-sm text-center" style="border: 1px solid #D4AF37;">

                    <h2 class="fw-bold mb-3" style="color: #1a1a1a; font-family: 'Playfair Display', serif;">
                        Recuperar contraseña
                    </h2>

                    <p class="text-secondary mb-4">
                        Ingresa el correo electrónico asociado a tu cuenta para recuperar el acceso.
                    </p>

                    <form class="text-start">

                        <div class="mb-4">
                            <label for="correo" class="form-label text-secondary">
                                Correo electrónico
                            </label>

                            <input type="email"
                                   class="form-control"
                                   id="correo"
                                   placeholder="correo@ejemplo.com"
                                   required>
                        </div>

                        <button type="submit"
                                class="btn btn-lg w-100 text-uppercase py-3 boton-ingresar">
                            Recuperar contraseña
                        </button>

                    </form>

                    <p class="mt-4 mb-0">
                        <a href="@Url.Action("Login", "Home")" class="text-secondary small">
                            <i class="fa fa-arrow-left me-1"></i>
                            Volver al inicio de sesión
                        </a>
                    </p>

                </div>
            </div>
        </div>
    </div>
</div>