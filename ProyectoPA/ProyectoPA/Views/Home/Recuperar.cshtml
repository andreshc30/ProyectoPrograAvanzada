@model ProyectoPA.Models.UsuarioModel
@{
    ViewBag.Title = "Recuperar Contraseña";
}

<div class="container-fluid p-0 hero-header bg-light d-flex align-items-center justify-content-center" style="min-height: 100vh;">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-11 col-sm-9 col-md-6 col-lg-4">

                <div class="bg-white p-4 p-md-5 shadow-sm text-center" style="border: 1px solid #D4AF37;">

                    <h2 class="fw-bold mb-3" style="color: #1a1a1a; font-family: 'Playfair Display', serif;">
                        Recuperar contraseña
                    </h2>

                    <p class="text-secondary mb-4">
                        Ingresa la cédula asociado a tu cuenta para recuperar el acceso.
                    </p>

                    @using (Html.BeginForm("Recuperar", "Home", FormMethod.Post, new { id = "recuperarForm", @class = "text-start" }))
                    {
                        if (ViewBag.Message != null)
                        {
                            <div class="alert alert-danger text-center">@ViewBag.Message</div>
                        }

                        <div class="mb-4">
                            <label class="form-label text-secondary">
                                Cédula
                            </label>
                            @Html.TextBoxFor(m => m.Cedula, new { @class = "form-control" })

                        </div>

                        <button type="submit"
                                class="btn btn-lg w-100 text-uppercase py-3 boton-ingresar">
                            Recuperar contraseña
                        </button>

                    }

                    <p class="mt-4 mb-0">
                        <a href="@Url.Action("Login", "Home")" class="text-secondary small">
                            <i class="fa fa-arrow-left me-1"></i>
                            Volver al inicio de sesión
                        </a>
                    </p>

                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/assets/js/recuperar.js"></script>
    <script src="~/assets/js/auth.js"></script>
}